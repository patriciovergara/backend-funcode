# Referencia para producción. Estas variables se configuran en el panel de
# Render, no en un archivo .env versionado. No incluyas valores reales aquí.

NODE_ENV=production
FRONTEND_ORIGIN=https://funcode.cl,https://www.funcode.cl

PGHOST=REEMPLAZAR_HOST_DE_NEON
PGPORT=5432
PGDATABASE=funcode
PGUSER=REEMPLAZAR_USUARIO
PGPASSWORD=REEMPLAZAR_CONTRASEÑA
PGSSLMODE=require

# 64 caracteres hexadecimales, distinto del secreto local.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_NUEVO

CONTACT_EMAIL=contacto@funcode.cl
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@funcode.cl
SMTP_PASS=REEMPLAZAR_CON_LA_CONTRASEÑA_DE_APLICACIÓN_ZOHO

# PORT lo define Render automáticamente.
